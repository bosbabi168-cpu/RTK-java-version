# Compiled class file
*.class

# Log file
*.log
logs/*.log.gz
logs/*.pid
packetlog.txt

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# PENTING: project ini sengaja TIDAK memakai Maven/Gradle — seluruh library
# eksternal disimpan sebagai jar di extLib/ dan HARUS ikut ter-commit,
# jadi kecualikan dari aturan *.jar di atas.
!extLib/*.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Hasil build (Ant maupun build.sh)
/build/
/dist/

# NetBeans
nbproject/private/

# IDE lain
*.iml
.idea/
